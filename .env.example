# 백엔드(서버) 환경변수 예시 — 실제 값은 .env 에 넣는다(.env 는 커밋 금지).
# API 키는 반드시 백엔드에만 두고 브라우저로 내보내지 않는다.

# --- 이미지 생성 (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- LLM Router (PASS/FAIL 판정) : Gemini 재사용 ---
ROUTER_PROVIDER=gemini
GEMINI_ROUTER_MODEL=gemini-3.8-flash

# --- 서버 ---
PORT=8000
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=20


# --- Supabase (서버 전용, 저장 로직 연동은 후속 작업) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-or-legacy-service-role-key
