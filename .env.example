# 백엔드(서버) 환경변수 예시 — 실제 값은 .env 에 넣는다(.env 는 커밋 금지).
# API 키는 반드시 백엔드에만 두고 브라우저로 내보내지 않는다.

# --- 이미지 생성 (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Image migration: set zeus only AFTER SQL + GPU smoke test pass.
IMAGE_PROVIDER=gemini
GPU_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
GPU_API_URL=https://YOUR-POD-ID-8000.proxy.runpod.net
GPU_API_KEY=
GPU_TIMEOUT_SECONDS=150
GPU_ROUTER_MODEL=Qwen/Qwen3.5-4B

# --- Router: set ROUTER_PROVIDER=zeus for measured Qwen; gemini for rollback ---
ROUTER_PROVIDER=gemini
# CLIP은 로컬 Mac에서만 실행. off / observe / gate
CLIP_MODE=off
# python -c 'import secrets; print(secrets.token_urlsafe(32))' 로 생성
CLIP_WORKER_TOKEN=
CLIP_TIMEOUT_SECONDS=20
# fallback: 연결 실패 시 Gemini 진행 / required: 오류로 중단
CLIP_FAILURE_POLICY=fallback
# gate에서만 필요. 실제 샘플로 보정 전에는 비워둠.
CLIP_REJECT_BELOW=
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite

# --- 서버 ---
PORT=8000
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=20


# --- Supabase (서버 전용, 저장 로직 연동은 후속 작업) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-or-legacy-service-role-key

# Optional event printing. Do not prefix these with VITE_.
PRINT_STATION_ID=booth-1
PRINT_PAIRING_TOKEN=
PRINT_WORKER_TOKEN=

# Phase 0-5: Mac bike receiver -> Render. Same value in bike repo .env.local.
BIKE_WORKER_TOKEN=
# Gemini uses API token counts only; no Wh estimate or cycling target is invented.
# IMAGE_PROVIDER=gemini and ROUTER_PROVIDER=gemini are the initial event setup.
# Model menu: operator registration uses separate per-profile secrets.
GPU_CONTROL_TOKEN=
GPU_4090_API_KEY=
GPU_4090_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
GPU_4090_ROUTER_MODEL=Qwen/Qwen3.5-4B
GPU_5090_API_KEY=
GPU_5090_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
GPU_5090_ROUTER_MODEL=Qwen/Qwen3.5-4B
