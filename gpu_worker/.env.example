# Set with the RunPod environment editor; never commit actual credentials.
GPU_API_KEY=replace-with-a-random-secret-at-least-32-characters
GPU_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# Required: copy the full immutable commit SHA from the model repository.
GPU_MODEL_REVISION=
GPU_LEDGER_PATH=/workspace/ai-slop/requests.sqlite3
HF_HOME=/workspace/huggingface
# Expose the physical GPU allocated to this Pod; do not override with a host index.
# CUDA_VISIBLE_DEVICES is normally supplied by the platform.

GPU_ROUTER_MODEL=Qwen/Qwen3.5-4B
GPU_ROUTER_REVISION=
# 5090 tested with bf16; 4090 requires reduced memory. Keep this with worker.env backups.
GPU_ROUTER_QUANTIZATION=bf16
